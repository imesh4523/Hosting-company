# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vpsadmin:strongpassword@localhost:5432/vpsplatform
POSTGRES_DB=vpsplatform
POSTGRES_USER=vpsadmin
POSTGRES_PASSWORD=strongpassword

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redispassword@localhost:6379
REDIS_PASSWORD=redispassword

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars

# ─── Proxmox ──────────────────────────────────────────────────────────────────
PROXMOX_HOST=https://your-proxmox-server:8006
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your_proxmox_password
PROXMOX_NODE=pve

# ─── DigitalOcean ─────────────────────────────────────────────────────────────
DO_API_KEY=dop_v1_your_digitalocean_api_key

# ─── Backblaze B2 ─────────────────────────────────────────────────────────────
B2_KEY_ID=your_b2_key_id
B2_APP_KEY=your_b2_application_key
B2_BUCKET_NAME=vps-backups
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_BASIC=price_basic_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_BUSINESS=price_business_id

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your_bot_token
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# ─── IPQualityScore (Fraud Detection) ────────────────────────────────────────
IPQS_API_KEY=your_ipqs_api_key

# ─── AES Encryption (API keys at rest) ────────────────────────────────────────
AES_ENCRYPTION_KEY=32_char_hex_key_for_api_key_encryption

# ─── Frontend URLs ────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com
