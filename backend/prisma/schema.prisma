generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RESELLER
  CUSTOMER
}

enum VPSStatus {
  STARTING
  RUNNING
  STOPPED
  REBUILDING
  SUSPENDED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  firstName     String?
  lastName      String?
  phone         String?
  address       String?
  city          String?
  state         String?
  postcode      String?
  country       String?
  role          Role     @default(CUSTOMER)
  twoFactorSecret String?
  isTwoFactorEnabled Boolean @default(false)
  fraudScore    Int      @default(0)
  isBanned      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vps           VPS[]
  invoices      Invoice[]
  tickets       Ticket[]
  fraudProfile  FraudProfile?
  transactions  Transaction[]
  paymentMethods PaymentMethod[]
}

model DigitalOceanAccount {
  id            String   @id @default(uuid())
  name          String
  apiKey        String   // Encrypted
  limit         Int      @default(10)
  usage         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vps           VPS[]
}

model VPS {
  id            String   @id @default(uuid())
  name          String
  dropletId     String?  @unique
  ipAddress     String?
  status        VPSStatus @default(STARTING)
  planId        String
  region        String
  image         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  doAccountId   String
  doAccount     DigitalOceanAccount @relation(fields: [doAccountId], references: [id])
}

model Invoice {
  id            String   @id @default(uuid())
  amount        Float
  currency      String   @default("USD")
  status        InvoiceStatus @default(PENDING)
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  transaction   Transaction?
}

model Transaction {
  id            String   @id @default(uuid())
  externalId    String?  @unique // Stripe/PayPal ID
  amount        Float
  status        String
  createdAt     DateTime @default(now())

  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  invoiceId     String   @unique
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
}

model Ticket {
  id            String   @id @default(uuid())
  subject       String
  status        TicketStatus @default(OPEN)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  messages      TicketMessage[]
}

model TicketMessage {
  id            String   @id @default(uuid())
  message       String
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())

  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
}

model FraudProfile {
  id            String   @id @default(uuid())
  score         Int
  ipAddress     String?
  isVpn         Boolean  @default(false)
  isProxy       Boolean  @default(false)
  isTor         Boolean  @default(false)
  lastChecked   DateTime @default(now())

  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id            String   @id @default(uuid())
  last4         String
  cardType      String
  cardHolder    String
  expiryDate    String
  nickname      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
