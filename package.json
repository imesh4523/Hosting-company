{
  "scripts": {
    "build": "cd backend && npm install && npm run build && cd ../frontend && npm install && npm run build",
    "start": "npx concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "build:frontend": "cd frontend && npm install && npm run build",
