generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ─────────────────────────────────────────────────────────────────
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  password      String
  role          String          @default("customer")
  status        String          @default("active")
  suspended     Boolean         @default(false)
  fraudScore    Float           @default(0.0)
  trustLevel    String          @default("new")
  lastLoginIp   String?
  banReason     String?
  activeVpsId   String?
  avatar          String?
  emailVerified   Boolean     @default(false)
  balance         Float       @default(0.0)
  stripeCustomerId String?
  
  // Profile
  phone         String?
  address1      String?
  address2      String?
  city          String?
  state         String?
  postcode      String?
  country       String?
  company       String?

  // 2FA
  twoFactorEnabled Boolean     @default(false)
  twoFactorSecret  String?     // AES Encrypted
  twoFactorBackupCodes String[] @default([])

  walletBalance   Float       @default(0.0)

  vms           VM[]
  invoices      Invoice[]
  tickets       SupportTicket[]
  affiliate     Affiliate?
  ipLogs        UserIPLog[]
  fraudLogs     FraudLog[]
  migrations    Migration[]
  vmHistory     VMHistory[]
  oauthAccounts   UserOAuth[]
  domains       Domain[]
  backups       Backup[]
  customDomains CustomDomain[]
  auditLogs     AuditLog[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ─── Cloud Accounts ────────────────────────────────────────────────────────
model CloudAccount {
  id              String      @id @default(uuid())
  name            String      // "DO-Trial-1", "Vultr-Main"
  provider        String      // digitalocean/vultr/linode/aws/azure/upcloud/kamatera
  
  // Credentials (encrypted AES-256)
  credentials     Json        
  
  // Credit info
  credits         Float       @default(0)
  creditExpiry    DateTime?   
  daysRemaining   Int?        
  balance         Float       @default(0)
  
  // Resource limits
  vmLimit         Int         @default(10)
  vmCount         Int         @default(0)
  
  // Status
  status          String      @default("active") // active/suspended/credits_low/credits_expired
  suspendReason   String?
  
  region          String      @default("global")
  notes           String?
  lastChecked     DateTime?
  
  vms             VM[]
  migrations      Migration[]
  migrationsTo    Migration[] @relation("MigrationToAccount")
  snapshots       Snapshot[]
  vmHistory       VMHistory[]
  creditHistory   CreditHistory[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model AuthSettings {
  id              String  @id @default(cuid())
  googleEnabled   Boolean @default(false)
  googleClientId  String?
  googleSecret    String? // encrypted
  
  facebookEnabled Boolean @default(false)
  facebookAppId   String?
  facebookSecret  String? // encrypted
  
  githubEnabled   Boolean @default(false)
  githubClientId  String?
  githubSecret    String? // encrypted
  
  emailEnabled    Boolean @default(true)
  updatedAt       DateTime @updatedAt
}

model PaymentSettings {
  id              String  @id @default(cuid())
  stripeEnabled   Boolean @default(false)
  stripeSecretKey String? // AES Encrypted
  stripePublicKey String?
  stripeWebhookSecret String? // AES Encrypted
  updatedAt       DateTime @updatedAt
}

model UserOAuth {
  id           String @id @default(cuid())
  userId       String
  provider     String // google/facebook/github
  providerId   String // provider's user ID
  email        String
  name         String
  avatar       String?
  accessToken  String? // encrypted
  createdAt    DateTime @default(now())
  
  user         User @relation(fields: [userId], references: [id])
  
  @@unique([provider, providerId])
}

model CreditHistory {
  id            String   @id @default(uuid())
  accountId     String
  credits       Float
  balance       Float
  daysRemaining Int?
  checkedAt     DateTime @default(now())
  
  account       CloudAccount @relation(fields: [accountId], references: [id])
}

// ─── VM Management ──────────────────────────────────────────────────────────
model VM {
  id              String      @id @default(uuid())
  cloudAccountId  String      
  provider        String      
  providerId      String?     @unique // e.g. DO droplet ID or AWS instance ID
  userId          String
  serverId        String?     // If linked to a local Proxmox server
  
  name            String
  hostname        String?
  ip              String?
  sshPort         Int         @default(22)
  status          String      @default("provisioning") // active/suspended/migrated/deleted
  planId          String?
  plan            Plan?       @relation(fields: [planId], references: [id])
  region          String?
  
  // Specs
  ram             Int         @default(1)   // GB
  cpu             Int         @default(1)   // cores
  disk            Int         @default(20)  // GB
  bandwidth       Int         @default(1000) // GB/month

  // Auth
  username        String      @default("root")
  rootPassword    String?     // AES encrypted
  
  // Timeline
  suspendedAt     DateTime?
  migratedAt      DateTime?
  migratedTo      String?     // new VM id
  
  user            User        @relation(fields: [userId], references: [id])
  account         CloudAccount @relation(fields: [cloudAccountId], references: [id])
  server          Server?     @relation(fields: [serverId], references: [id])
  snapshots       Snapshot[]
  migrations      Migration[]
  accountHistory  VMAccountHistory[]
  vmHistory       VMHistory[]
  recoveryLogs    RecoveryLog[]
  backups         Backup[]
  customDomains   CustomDomain[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model VMAccountHistory {
  id          String   @id @default(uuid())
  vmId        String
  accountId   String
  provider    String
  ip          String?
  startedAt   DateTime @default(now())
  endedAt     DateTime? 
  reason      String?   
  
  vm          VM       @relation(fields: [vmId], references: [id])
}

// ─── Snapshots ─────────────────────────────────────────────────────────────
model Snapshot {
  id              String      @id @default(uuid())
  vmId            String
  cloudAccountId  String
  userId          String
  providerSnapshotId String?  @unique
  b2FileId        String?
  name            String
  sizeGb          Float       @default(0)
  status          String      @default("pending") // pending/ready/failed
  type            String      @default("auto")    // auto/manual/pre-migration
  restoredAt      DateTime?
  restoredTo      String?
  expiresAt       DateTime?
 
  vm              VM           @relation(fields: [vmId], references: [id])
  account         CloudAccount @relation(fields: [cloudAccountId], references: [id])
  migrations      Migration[]
  createdAt       DateTime     @default(now())
}

// ─── VM History (every event) ──────────────────────────────────────────────
model VMHistory {
  id              String      @id @default(uuid())
  vmId            String
  userId          String
  event           String
  fromAccountId   String?
  toAccountId     String?
  fromIp          String?
  toIp            String?
  snapshotId      String?
  reason          String?
  triggeredBy     String      @default("auto") // auto/admin/user
  adminId         String?
  metadata        Json?
  duration        Int?        

  vm              VM           @relation(fields: [vmId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  fromAccount     CloudAccount? @relation(fields: [fromAccountId], references: [id])
  createdAt       DateTime     @default(now())
}

// ─── Migrations ────────────────────────────────────────────────────────────
model Migration {
  id              String          @id @default(uuid())
  userId          String
  vmId            String
  fromAccountId   String
  toAccountId     String
  fromVpsId       String          // Original VM ID
  toVpsId         String?         // Target VM ID
  snapshotId      String?
  fromIp          String?
  toIp            String?
  status          String          @default("pending")
  trigger         String
  retryCount      Int             @default(0)
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  failedAt        DateTime?
  failReason      String?
  notifiedUser    Boolean         @default(false)
  downtimeMinutes Int?

  user            User            @relation(fields: [userId], references: [id])
  vm              VM              @relation(fields: [vmId], references: [id])
  fromAccount     CloudAccount    @relation(fields: [fromAccountId], references: [id])
  toAccount       CloudAccount    @relation("MigrationToAccount", fields: [toAccountId], references: [id])
  snapshot        Snapshot?       @relation(fields: [snapshotId], references: [id])
  steps           MigrationStep[]
  createdAt       DateTime        @default(now())
}

// ─── Migration Steps ───────────────────────────────────────────────────────
model MigrationStep {
  id            String      @id @default(uuid())
  migrationId   String
  step          Int
  name          String
  status        String      @default("pending") // pending/running/done/failed/skipped
  startedAt     DateTime?
  completedAt   DateTime?
  error         String?
  metadata      Json?

  migration     Migration   @relation(fields: [migrationId], references: [id])
}

// ─── Servers (Proxmox nodes) ────────────────────────────────────────────────
model Server {
  id              String    @id @default(uuid())
  name            String
  type            String    @default("proxmox") // proxmox/digitalocean
  apiUrl          String
  apiUser         String?
  apiKey          String?
  region          String?
  node            String?
  maxVMs          Int       @default(50)
  status          String    @default("active")
  maintenanceMode Boolean   @default(false)
  notes           String?

  vms             VM[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── Plans ─────────────────────────────────────────────────────────────────
model PlanCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  plans       Plan[]
  createdAt   DateTime @default(now())
}

model Plan {
  id            String       @id @default(uuid())
  name          String
  categoryId    String
  category      PlanCategory @relation(fields: [categoryId], references: [id])
  priceMonthly  Float
  priceYearly   Float?
  ram           String?
  cpu           String?
  storage       String?
  bandwidth     String?
  doSize        String?      // DO slug e.g. "s-1vcpu-2gb"
  vms           VM[]
  createdAt     DateTime     @default(now())
}

// ─── Billing ───────────────────────────────────────────────────────────────
model Invoice {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  amount        Float
  status        String        @default("pending")
  plan          String?
  stripeSessionId String?
  provider      String        @default("stripe")
  dueDate       DateTime      @default(now())
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
}

model Transaction {
  id              String    @id @default(uuid())
  userId          String?
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  amount          Float
  method          String    @default("stripe")
  status          String    @default("success")
  stripeSessionId String?
  plan            String?
  createdAt       DateTime  @default(now())
}

// ─── Support ───────────────────────────────────────────────────────────────
model SupportTicket {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  subject     String
  status      String          @default("open")
  priority    String          @default("medium")
  messages    TicketMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
  sender      String
  message     String
  createdAt   DateTime      @default(now())
}

// ─── Affiliate ─────────────────────────────────────────────────────────────
model Affiliate {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  code        String    @unique
  commission  Float     @default(0.0)
  payouts     Payout[]
  createdAt   DateTime  @default(now())
}

model Payout {
  id          String    @id @default(uuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  amount      Float
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

// ─── Fraud Detection ───────────────────────────────────────────────────────
model FraudLog {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  score       Float
  reasons     String[]
  action      String
  createdAt   DateTime  @default(now())
}

// ─── Recovery ──────────────────────────────────────────────────────────────
model RecoveryLog {
  id          String    @id @default(uuid())
  vpsId       String
  vps         VM       @relation(fields: [vpsId], references: [id])
  action      String
  status      String
  message     String?
  createdAt   DateTime  @default(now())
}

// ─── Analytics ─────────────────────────────────────────────────────────────
model SystemMetric {
  id          String    @id @default(uuid())
  type        String
  value       Float
  timestamp   DateTime  @default(now())
}

model UserIPLog {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  ipAddress     String
  country       String?
  city          String?
  isSuspicious  Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

// ─── Domains ───────────────────────────────────────────────────────────────
model Domain {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  domainName    String    @unique
  status        String    @default("pending")
  expiryDate    DateTime
  nextDueDate   DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model News {
  id        String   @id @default(uuid())
  title     String
  content   String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Backup ────────────────────────────────────────────────────────────────
model Backup {
  id            String   @id @default(uuid())
  userId        String
  vmId          String
  snapshotId    String?
  b2Path        String?
  gdrivePath    String?
  sizeGb        Float    @default(0)
  status        String   @default("pending") // pending/completed/failed
  type          String   @default("auto")    // auto/manual
  user          User     @relation(fields: [userId], references: [id])
  vm            VM       @relation(fields: [vmId], references: [id])
  createdAt     DateTime @default(now())
  restoredAt    DateTime?
}

// ─── Custom Domains ────────────────────────────────────────────────────────
model CustomDomain {
  id            String   @id @default(uuid())
  userId        String
  vmId          String
  domain        String   @unique
  containerPort Int      @default(80)
  sslActive     Boolean  @default(false)
  cfDnsId       String?
  verifiedAt    DateTime?
  user          User     @relation(fields: [userId], references: [id])
  vm            VM       @relation(fields: [vmId], references: [id])
  createdAt     DateTime @default(now())
}

// ─── Alerts ────────────────────────────────────────────────────────────────
model Alert {
  id          String   @id @default(uuid())
  type        String   // vps_down/account_suspended/credits_low/payment_failed/fraud_detected/backup_failed/migration_started/migration_done
  severity    String   @default("info") // info/warning/critical/emergency
  message     String
  metadata    Json?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime @default(now())
}

// ─── Audit Log ────────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  details   Json?
  ip        String?
  admin     User     @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
}

// ─── Platform Settings ─────────────────────────────────────────────────────
model Settings {
  id                    String  @id @default("singleton")
  maintenanceMode       Boolean @default(false)
  maintenanceMessage    String?
  telegramBotToken      String?
  telegramAdminChatId   String?
  backupSchedule        String  @default("0 2 * * *")
  backupRetentionDays   Int     @default(7)
  fraudAutobanScore     Int     @default(80)
  resendApiKey          String?
  cloudflareApiKey      String?
  cloudflareZoneId      String?
  ipqsApiKey            String?
  domain                String  @default("yourdomain.com")
  b2KeyId               String?
  b2AppKey              String?
  b2BucketName          String?
  updatedAt             DateTime @updatedAt
}
