generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String         @id @default(uuid())
  name                 String
  email                String         @unique
  password             String?
  role                 String         @default("customer")
  status               String         @default("active")
  emailVerified        Boolean        @default(false)
  twoFactorSecret      String?
  twoFactorEnabled     Boolean        @default(false)
  avatar               String?
  fraudScore           Int            @default(0)
  balance              Float          @default(0)
  stripeCustomerId     String?
  defaultPaymentMethod String?
  autoRecharge         Boolean        @default(true)
  autoRechargeAmount   Float          @default(10)
  autoRechargeBelow    Float          @default(3)
  createdAt            DateTime       @default(now())
  bannedAt             DateTime?
  bannedReason         String?
  AuditLog             AuditLog[]
  Backup               Backup[]
  CustomDomain         CustomDomain[]
  deployedApps         DeployedApp[]
  fraudLogs            FraudLog[]
  Payment              Payment[]
  Ticket               Ticket[]
  UsageRecord          UsageRecord[]
  oauthAccounts        UserOAuth[]
  VPSInstance          VPSInstance[]
  subUsers             SubUser[]      @relation("UserToSubUser")
  contacts             Contact[]
  emailLogs            EmailLog[]
  cards                UserCard[]
  orders               Order[]
  transactions         Transaction[]
  invoices             Invoice[]
}

model CloudAccount {
  id            String          @id @default(uuid())
  name          String
  provider      String
  credentials   Json
  status        String          @default("active")
  credits       Float           @default(0)
  creditExpiry  DateTime?
  daysRemaining Int?
  balance       Float           @default(0)
  vmLimit       Int             @default(10)
  vmCount       Int             @default(0)
  region        String          @default("sgp")
  isProxmox     Boolean         @default(false)
  proxmoxNode   String?
  lastChecked   DateTime?
  suspendedAt   DateTime?
  suspendReason String?
  createdAt     DateTime        @default(now())
  creditHistory CreditHistory[]
  migrations    Migration[]
  snapshots     Snapshot[]
  VPSInstance   VPSInstance[]
}

model AuthSettings {
  id              String   @id @default("singleton")
  googleEnabled   Boolean  @default(false)
  googleClientId  String?
  googleSecret    String?
  facebookEnabled Boolean  @default(false)
  facebookAppId   String?
  facebookSecret  String?
  githubEnabled   Boolean  @default(false)
  githubClientId  String?
  githubSecret    String?
  emailEnabled    Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model UserOAuth {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String
  email      String
  name       String
  avatar     String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
}

model CreditHistory {
  id            String       @id @default(uuid())
  accountId     String
  credits       Float
  balance       Float
  daysRemaining Int?
  checkedAt     DateTime     @default(now())
  account       CloudAccount @relation(fields: [accountId], references: [id])
}

model Snapshot {
  id             String       @id @default(uuid())
  vpsId          String
  cloudAccountId String
  userId         String
  providerSnapId String?
  b2FileId       String?
  gdriveFileId   String?
  name           String
  sizeGb         Float        @default(0)
  status         String       @default("pending")
  type           String       @default("auto")
  storagePath    String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?
  restoredAt     DateTime?
  restoredTo     String?
  account        CloudAccount @relation(fields: [cloudAccountId], references: [id])
  VPSInstance    VPSInstance  @relation(fields: [vpsId], references: [id])
}

model Migration {
  id            String          @id @default(uuid())
  userId        String
  vpsId         String
  fromAccountId String
  toAccountId   String
  fromIp        String
  toIp          String?
  snapshotId    String?
  status        String          @default("pending")
  trigger       String
  currentStep   Int             @default(0)
  totalSteps    Int             @default(10)
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  failedAt      DateTime?
  failReason    String?
  retryCount    Int             @default(0)
  notifiedUser  Boolean         @default(false)
  downtime      Int?
  fromAccount   CloudAccount    @relation(fields: [fromAccountId], references: [id])
  VPSInstance   VPSInstance     @relation(fields: [vpsId], references: [id])
  steps         MigrationStep[]
}

model MigrationStep {
  id          String    @id @default(uuid())
  migrationId String
  step        Int
  name        String
  status      String    @default("pending")
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  metadata    Json?
  migration   Migration @relation(fields: [migrationId], references: [id])
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  ram         Int
  cpu         Int
  disk        Int
  bandwidth   Int
  price       Float
  hourlyPrice Float
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  orders      Order[]
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  isAdmin   Boolean  @default(false)
  message   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model FraudLog {
  id        String   @id @default(uuid())
  userId    String
  reason    String
  points    Int
  score     Int
  action    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model DeployedApp {
  id             String       @id @default(uuid())
  userId         String
  cloudAccountId String
  doAppId        String?
  repoUrl        String
  repoBranch     String       @default("main")
  framework      String
  buildCommand   String?
  runCommand     String?
  port           Int          @default(8080)
  status         String       @default("queued")
  doUrl          String?
  subdomain      String?
  fullUrl        String?
  envVars        Json?
  dbUrl          String?
  createdAt      DateTime     @default(now())
  deployedAt     DateTime?
  user           User         @relation(fields: [userId], references: [id])
  deployments    Deployment[]
}

model Deployment {
  id             String      @id @default(uuid())
  appId          String
  doDeploymentId String?
  status         String
  buildLogs      String?
  errorLogs      String?
  errorAnalysis  String?
  suggestedFix   String?
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  app            DeployedApp @relation(fields: [appId], references: [id])
}

model Alert {
  id         String    @id
  type       String
  severity   String    @default("info")
  message    String
  metadata   Json?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String   @id
  adminId   String
  action    String
  target    String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [adminId], references: [id])
}

model Backup {
  id          String      @id
  userId      String
  vpsId       String
  snapshotId  String?
  b2Path      String?
  gdrivePath  String?
  sizeGb      Float       @default(0)
  status      String      @default("pending")
  type        String      @default("auto")
  createdAt   DateTime    @default(now())
  restoredAt  DateTime?
  User        User        @relation(fields: [userId], references: [id])
  VPSInstance VPSInstance @relation(fields: [vpsId], references: [id])
}

model BrandingSettings {
  id             String   @id @default("singleton")
  platformName   String   @default("YouuHost")
  websiteUrl     String   @default("https://youuhost.com")
  supportEmail   String   @default("support@youuhost.com")
  telegramLink   String   @default("t.me/youuhost")
  welcomeMessage String   @default("Your VPS is ready!")
  asciiColor     String   @default("cyan")
  updatedAt      DateTime
}

model CustomDomain {
  id            String      @id
  userId        String
  vpsId         String
  domain        String      @unique
  containerPort Int
  sslActive     Boolean     @default(false)
  cfDnsId       String?
  verifiedAt    DateTime?
  createdAt     DateTime    @default(now())
  User          User        @relation(fields: [userId], references: [id])
  VPSInstance   VPSInstance @relation(fields: [vpsId], references: [id])
}

model Payment {
  id            String    @id
  userId        String
  amount        Float
  currency      String    @default("USD")
  status        String
  provider      String
  providerPayId String?
  type          String    @default("topup")
  description   String?
  vpsId         String?
  refundedAt    DateTime?
  refundAmount  Float?
  createdAt     DateTime  @default(now())
  User          User      @relation(fields: [userId], references: [id])
}

model Settings {
  id                  String   @id @default("singleton")
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String?
  telegramBotToken    String?
  telegramAdminChatId String?
  backupSchedule      String   @default("0 2 * * *")
  backupRetentionDays Int      @default(7)
  fraudAutobanScore   Int      @default(80)
  minBalance          Float    @default(3)
  autoRechargeAmount  Float    @default(10)
  domain              String   @default("youuhost.com")
  stripeSecretKey     String?
  stripePublicKey     String?
  stripeWebhookSecret String?
  paypalClientId      String?
  paypalSecret        String?
  cloudflareApiKey    String?
  cloudflareZoneId    String?
  ipqsApiKey          String?
  resendApiKey        String?
  b2KeyId             String?
  b2AppKey            String?
  b2BucketName        String?
  updatedAt           DateTime
}

model Ticket {
  id        String          @id
  userId    String
  subject   String
  status    String          @default("open")
  priority  String          @default("medium")
  createdAt DateTime        @default(now())
  updatedAt DateTime
  User      User            @relation(fields: [userId], references: [id])
  messages  TicketMessage[]
}

model UsageRecord {
  id          String      @id
  userId      String
  vpsId       String
  hours       Float       @default(1)
  cost        Float
  billedAt    DateTime    @default(now())
  User        User        @relation(fields: [userId], references: [id])
  VPSInstance VPSInstance @relation(fields: [vpsId], references: [id])
}

model VPSHistory {
  id            String      @id
  vpsId         String
  userId        String
  event         String
  fromAccountId String?
  toAccountId   String?
  fromIp        String?
  toIp          String?
  reason        String?
  triggeredBy   String
  adminId       String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  VPSInstance   VPSInstance @relation(fields: [vpsId], references: [id])
}

model VPSInstance {
  id              String         @id
  userId          String
  cloudAccountId  String
  providerId      String
  vmId            String?
  proxmoxNode     String?
  name            String
  hostname        String
  ip              String
  sshPort         Int
  username        String         @default("root")
  password        String
  rootPassword    String
  status          String         @default("active")
  plan            String
  ram             Int
  cpu             Int
  disk            Int
  bandwidth       Int
  os              String         @default("ubuntu-22.04")
  region          String
  price           Float
  hourlyPrice     Float
  brandingApplied Boolean        @default(false)
  createdAt       DateTime       @default(now())
  suspendedAt     DateTime?
  migratedAt      DateTime?
  migratedTo      String?
  Backup          Backup[]
  CustomDomain    CustomDomain[]
  Migration       Migration[]
  Snapshot        Snapshot[]
  UsageRecord     UsageRecord[]
  VPSHistory      VPSHistory[]
  recoveryLogs    RecoveryLog[]
  CloudAccount    CloudAccount   @relation(fields: [cloudAccountId], references: [id])
  User            User           @relation(fields: [userId], references: [id])
}

model SubUser {
  id          String   @id @default(uuid())
  parentId    String
  email       String   @unique
  name        String
  permissions Json
  status      String   @default("pending")
  inviteToken String?  @unique
  invitedAt   DateTime @default(now())
  joinedAt    DateTime?
  parent      User     @relation("UserToSubUser", fields: [parentId], references: [id], onDelete: Cascade)
}

model Contact {
  id          String   @id @default(uuid())
  userId      String
  firstName   String
  lastName    String
  email       String
  company     String?
  address1    String?
  address2    String?
  city        String?
  state       String?
  postcode    String?
  country     String?
  phone       String?
  isBilling   Boolean  @default(false)
  isTechnical Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id      String   @id @default(uuid())
  userId  String
  subject String
  content String
  status  String   @default("sent")
  sentAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCard {
  id          String   @id @default(uuid())
  userId      String
  stripePmId  String   @unique
  fingerprint String
  brand       String?
  last4       String
  expMonth    Int
  expYear     Int
  isFlagged   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fingerprint])
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  amount    Float
  status    String   @default("pending")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  amount          Float
  type            String   @default("credit")
  status          String   @default("success")
  method          String
  stripeSessionId String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model RecoveryLog {
  id        String      @id @default(uuid())
  vpsId     String
  action    String
  status    String
  message   String?
  createdAt DateTime    @default(now())
  vps       VPSInstance @relation(fields: [vpsId], references: [id])
}

model Invoice {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  status    String   @default("unpaid")
  dueDate   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
